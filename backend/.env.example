# Cópia local: `cp .env.example .env` (o arquivo .env é ignorado pelo Git).
# Sem MAIL_ENABLED=true o app funciona normalmente e não envia e-mails.

#MAIL_ENABLED=true
# Chave de API do Resend. Gere em https://resend.com/api-keys
#RESEND_API_KEY=re_sua_chave
# Sem domínio verificado no Resend, a entrega só funciona para o e-mail da própria conta.
#MAIL_TO=e-mail-da-conta-resend
