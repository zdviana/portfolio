# Cópia local: `cp .env.example .env` (o arquivo .env é ignorado pelo Git).
# Sem MAIL_ENABLED=true o app funciona normalmente e não envia e-mails.

#MAIL_ENABLED=true
#MAIL_USERNAME=seu-email@gmail.com
# Senha de app do Google (não a senha da conta). Exige verificação em duas etapas.
# Gere em https://myaccount.google.com/apppasswords
#MAIL_PASSWORD=senha-de-app-do-google
#MAIL_TO=daviviana.dev@gmail.com
